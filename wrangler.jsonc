{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "elenymakes",
    "main": ".open-next/worker.js",
    "compatibility_date": "2024-09-23",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "elenymakes-db",
            "database_id": "f5bdc489-4b3f-4ca5-b996-1f7e48e73e9b"
        },
        {
            "binding": "elenymakes_db",
            "database_name": "elenymakes-db",
            "database_id": "f5bdc489-4b3f-4ca5-b996-1f7e48e73e9b",
            "remote": true
        }
    ]
}